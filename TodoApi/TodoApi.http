@TodoApi_HostAddress = http://localhost:5000
# Note: If your local app runs on a different port (e.g., https://localhost:7123 or http://localhost:5124), 
# update the port number above to match your running application.

### 1. Create a New Todo Item (POST)
POST {{TodoApi_HostAddress}}/api/todos
Content-Type: application/json

{
  "name": "Finish the .NET Minimal API tutorial",
  "isComplete": false
}

### 2. Get All Todo Items (GET All)
GET {{TodoApi_HostAddress}}/api/todos
Accept: application/json

### 3. Get a Specific Todo Item by ID (GET by ID)
# Replace '1' with a valid ID returned from your database
GET {{TodoApi_HostAddress}}/api/todos/1
Accept: application/json

### 4. Update an Existing Todo Item (PUT)
# Replace '1' with the ID of the item you want to modify
PUT {{TodoApi_HostAddress}}/api/todos/1
Content-Type: application/json

{
  "name": "Finish the .NET Minimal API tutorial (Completed!)",
  "isComplete": true
}

### 5. Delete a Todo Item (DELETE)
# Replace '1' with the ID of the item you want to remove
DELETE {{TodoApi_HostAddress}}/api/todos/1
Accept: application/json
